{
  "name": "klu-erp-assistant",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Human-controlled ERP CAPTCHA magnification and accessibility helper",
  "engines": { "node": ">=20" },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "set-domain": "node scripts/set-erp-domain.mjs",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "verify:security": "node scripts/verify-security.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "package": "npm run icons && node scripts/package-release.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "release": "npm test && npm run verify:security && npm run benchmark && npm run package && npm run validate:package"
  }
}
