{
  "manifest_version": 3,
  "name": "KLU ERP Assistant",
  "version": "2.1.0",
  "description": "Automatically reads and enters the CAPTCHA on the KLU ERP portal.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://newerp.kluniversity.in/*"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
